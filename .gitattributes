/frontend/public/manuals/** export-ignore
/frontend/public/theme-screenshots export-ignore
/frontend/public/theme-screenshots/** export-ignore
/frontend/public/Web-Templates export-ignore
/frontend/public/Web-Templates/** export-ignore
