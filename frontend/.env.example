# Frontend environment variables (Vite)
#
# This project uses relative API paths by default (see src/lib/api.ts), so
# you typically don't need any variables for local development.
# Hosted UMP API base for production integrations.
# VITE_UMP_BASE_URL=https://ump.example.com/api/v1
#
# Optional dev override for Vite proxy target (default is http://localhost:8001)
# VITE_BACKEND_URL=http://localhost:8000
