# Frontend environment variables (Vite)
#
# This project uses relative API paths by default (see src/lib/api.ts), so
# you typically don't need any variables for local development.
# Hosted UMP API base for production integrations.
# VITE_UMP_BASE_URL=https://ump.example.com/api/v1
#
# Optional dev override for Vite proxy target (default is http://127.0.0.1:8000)
# VITE_BACKEND_URL=http://127.0.0.1:8000
# Vite proxy target for IoT API (defaults to VITE_BACKEND_URL).
# VITE_IOT_BACKEND_URL=http://127.0.0.1:8000
# API base override for deployments that do not use the relative /api/v1 path.
# VITE_API_BASE_URL=/api/v1
# Base path when the app is hosted below the domain root.
# VITE_BASE_PATH=/
# Optional external UMP API integration.
# VITE_UMP_BASE_URL=https://ump.example.com/api/v1
