# OS / editor
.DS_Store
.vscode/
.idea/
.fleet/

# Local dev overrides
/docker-compose.yml

# Playwright MCP tool artifacts (local screenshots/snapshots/logs)
.playwright-mcp/
evidence-screenshots-FC/

# Secrets - Keep .env.production for CI/CD
**/.env
**/.env.local
**/.env.bak
**/.env.backup
**/*.env.bak
**/*.env.backup
!**/.env.example
!**/.env.sample
!**/.env.production

# Dependencies / build outputs
**/node_modules/
**/vendor/
**/dist/
**/.phpunit.result.cache

# Laravel runtime artifacts - Keep storage structure
backend/bootstrap/cache/*.php
backend/database/*.sqlite
backend/database/database.sqlite

# Keep storage folder structure with .gitkeep files
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitkeep
backend/storage/framework/cache/*.php
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitkeep
backend/storage/framework/views/*
!backend/storage/framework/views/.gitkeep
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitkeep

# Keep logs folder but ignore log files
backend/storage/logs/*.log

# Keep app storage structure
backend/storage/app/public/*
!backend/storage/app/public/.gitkeep

# Generated published-site snapshots — artifacts only, public pages are
# served from the database (PublishingService); never commit these.
backend/storage/app/website-builder/

# Published/admin assets (generated)
backend/public/css/filament/
backend/public/js/filament/

# Storage symlink (will be created on server)
backend/public/storage

# Logs
**/npm-debug.log
**/yarn-error.log

# Do not push this folder
test-sample/

# Kiro steering documents
.kiro/steering/
STEERING-PACK-ADDENDUM-REVIEW.md

# Ad-hoc local validation scripts (repo root only — this rule previously
# matched *validation*.php anywhere and silently excluded
# SFRSValidationService.php, the missing class behind #698, and would exclude
# any new *Validation* source/interface under backend/).
/*validation*.php

# OpenClaw implementation pack (local reference only)
noovaerp-openclaw-implementation-pack/

# Database backups / dumps — never commit (large binaries + may contain PII)
*.sql
*.sql.gz
*.dump
*.dump.gz
*.tar.gz
acme_local_fresh_*.dump
noovaerp_*_backup_*.dump
noovaerp_*_backup_*.sql.gz
noovaerp_current_backup.sql
noovaerp_local_backup_*.sql

# Tenant JSON backups written by the app's 7300-backup feature
backend/storage/app/7300-backups/

# Exported data files at repo root (customer/invoice masterlists — contain PII)
/*.xlsx
/*.csv

# Runtime tenant report exports — never commit
backend/storage/app/reports/*
!backend/storage/app/reports/.gitkeep

# Python bytecode (ocr-service)
__pycache__/
*.pyc
!ocr-service/requirements*.txt

# Laravel runtime caches that are not source
backend/storage/framework/cache/laravel-excel/
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore

# OCR service uploads (runtime tenant documents - never commit)
backend/storage/app/ocr-documents/

# Tenant runtime data (bank statement previews, recovery dumps - never commit)
backend/storage/app/bank-statements/
backend/storage/tenant-recovery/

# Playwright artifacts
test-results/
playwright-report/

# #1001 payment advice uploads (runtime tenant documents)
backend/storage/app/payment-advices/

# Client-provided review material (do not commit)
Template-PDFs/

# ---------------------------------------------------------------------------
# Local-only working files (open-source repo: kept on disk, never pushed)
# ---------------------------------------------------------------------------
*.md
!/README.md
docs/
deployment/
.claude/
.superpowers/
.cursor/
tmp_scripts/
.github/agents/
backend/evidence-*/
backend/test_results.xml
