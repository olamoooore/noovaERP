# Root environment example for local development and Docker.
# Copy this file to .env only if your local tooling reads a root .env.
# The Laravel app reads backend/.env; the Vite app reads frontend/.env.

APP_NAME=NoovaERP
APP_ENV=local
APP_KEY=
APP_URL=http://localhost:8000
APP_DEBUG=true

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=noovaerp
DB_USERNAME=postgres
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file

CENTRAL_DOMAINS=localhost,127.0.0.1
TENANT_SEED_PASSWORD=

FRONTEND_URL=http://localhost:5173
VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_IOT_BACKEND_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=/api/v1

OCR_ENGINE=tesseract
OCR_HOST=127.0.0.1
OCR_PORT=5050
OCR_SERVICE_KEY=change-me
OCR_POPPLER_PATH=
OCR_MAX_UPLOAD_BYTES=10485760
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
