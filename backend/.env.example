APP_NAME="NoovaERP"
APP_ENV=local
APP_KEY=

# Explicit credentials required only when running the Financial Close
# capability-account seeder. Never commit usable values here.
FINANCIAL_CLOSE_ACCOUNTANT_PASSWORD=
FINANCIAL_CLOSE_MANAGER_PASSWORD=
SUPERADMIN_PASSWORD=
APP_DEBUG=true
APP_URL=http://localhost:8000

BANK_STATEMENT_MATCH_SEARCH_WINDOW_DAYS=45

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=noovaerp
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_DRIVER=log
BROADCAST_CONNECTION=log

CACHE_DRIVER=redis
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Use Predis in dev to avoid requiring the PHP ext-redis (phpredis) extension.
REDIS_CLIENT=predis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_KEY=
FRONTEND_URL=http://localhost:5173

SANCTUM_STATEFUL_DOMAINS=localhost:5173

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ⚠️  SAFETY: Set to false in production to block migrate:fresh
# When false, `migrate:fresh` and `migrate:fresh --seed` will be blocked
# Use `migrate:fresh-safe` instead (requires confirmation)
ALLOW_MIGRATE_FRESH=true

# Tenancy
TENANCY_DATABASE=landlord
CENTRAL_DOMAINS=localhost,127.0.0.1

# Dedicated storefront tenant (used by /api/v1/website-public/* and /api/v1/web-shop/*)
# Set ONE of these in non-local environments to avoid tenant resolution 404s.
STOREFRONT_TENANT_ID=
STOREFRONT_TENANT_EMAIL=

# S3 Compatible Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# AI Chatbot Configuration
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=500
LLM_TIMEOUT=60
LLM_TOP_P=0.9

# OCR microservice (ocr-service/) — issue #174.
# OCR_SERVICE_KEY must match the OCR service's own OCR_SERVICE_KEY; the backend
# refuses to call the service without it and the service returns 401 without
# the matching X-OCR-Service-Key header.
OCR_SERVICE_URL=http://localhost:5050
OCR_SERVICE_KEY=
# Cerebras cloud (BYOK). Leave blank to require tenants to bring their own key.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3.8-27b
