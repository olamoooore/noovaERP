{
    "name": "noovaerp/backend",
    "type": "project",
    "description": "NoovaERP SaaS - Multi-tenant ERP Backend",
    "keywords": ["laravel", "erp", "saas", "multi-tenant", "accounting"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^2.0",
        "filament/filament": "^3.0",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "maatwebsite/excel": "^3.1",
        "predis/predis": "^2.3",
        "resend/resend-php": "^1.15",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-permission": "^6.0",
        "stancl/tenancy": "^3.8",
        "stripe/stripe-php": "^13.0"
    },
    "require-dev": {
        "brianium/paratest": "^7.8",
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\AI\\": "modules/AI/src/",
            "Modules\\Communication\\": "modules/Communication/src/",
            "Modules\\Core\\": "modules/Core/src/",
            "Modules\\Ecommerce\\": "modules/Ecommerce/src/",
            "Modules\\EventManagement\\": "modules/EventManagement/",
            "Modules\\FieldService\\": "modules/FieldService/src/",
            "Modules\\FinancialClose\\": "modules/FinancialClose/src/",
            "Modules\\FinancialReporting\\": "modules/FinancialReporting/src/",
            "Modules\\HRM\\": "modules/HRM/src/",
            "Modules\\HRM\\Database\\Factories\\": "modules/HRM/database/factories/",
            "Modules\\HRM\\Database\\Seeders\\": "modules/HRM/database/seeders/",
            "Modules\\FinancialReporting\\Database\\Factories\\": "modules/FinancialReporting/database/factories/",
            "Modules\\FinancialReporting\\Database\\Seeders\\": "modules/FinancialReporting/database/seeders/",
            "Modules\\PaymentGateway\\Database\\Seeders\\": "modules/PaymentGateway/database/seeders/",
            "Modules\\Communication\\Database\\Seeders\\": "modules/Communication/database/seeders/",
            "Modules\\IoT\\Database\\Seeders\\": "modules/IoT/database/seeders/",
            "Modules\\OCRBookkeeping\\Database\\Seeders\\": "modules/OCRBookkeeping/database/seeders/",
            "Modules\\Loyalty\\Database\\Seeders\\": "modules/Loyalty/database/seeders/",
            "Modules\\Inventory\\": "modules/Inventory/src/",
            "Modules\\IoT\\": "modules/IoT/src/",
            "Modules\\Loyalty\\": "modules/Loyalty/src/",
            "Modules\\OCRBookkeeping\\": "modules/OCRBookkeeping/src/",
            "Modules\\PaymentGateway\\": "modules/PaymentGateway/src/",
            "Modules\\POS\\": "modules/POS/src/",
            "Modules\\Sales\\": "modules/Sales/src/",
            "Modules\\WebsiteBuilder\\": "modules/WebsiteBuilder/",
            "Modules\\WhatsApp\\": "modules/WhatsApp/src/",
            "Modules\\CRM\\": "modules/CRM/src/",
            "Modules\\": "modules/",
            "Modules\\Fulfillment\\": "modules/Fulfillment/src/",
            "Modules\\TemplateBuilder\\": "modules/TemplateBuilder/src/",
            "Modules\\AccountingFoundation\\": "modules/AccountingFoundation/src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "classmap": []
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Modules\\HRM\\Tests\\": "modules/HRM/tests/",
            "Modules\\FinancialReporting\\Tests\\": "modules/FinancialReporting/tests/",
            "Modules\\OCRBookkeeping\\Tests\\": "modules/OCRBookkeeping/tests/",
            "Modules\\EventManagement\\Tests\\": "modules/EventManagement/tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
