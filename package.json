{
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && php artisan serve",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:queue": "cd backend && php artisan queue:work --tries=3 --timeout=60",
    "dev": "concurrently -n backend,frontend,queue -c green,blue,yellow \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:queue\""
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
